# TruthLens AI Configuration

# Mode Configuration
DEMO_MODE=True

# Security
SECRET_KEY=truthlens_super_secret_jwt_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=postgresql://truthlens:truthlens_password@localhost:5432/truthlens_db
# For local file SQLite fallback:
# DATABASE_URL=sqlite:///./truthlens.db

# LLM Providers (Configure when DEMO_MODE=False)
LLM_PROVIDER=demo # demo, openai, gemini, anthropic
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Search Providers (Configure when DEMO_MODE=False)
SEARCH_PROVIDER=demo # demo, tavily, serper, google
TAVILY_API_KEY=your-tavily-api-key
SERPER_API_KEY=your-serper-api-key
GOOGLE_SEARCH_API_KEY=your-google-api-key
GOOGLE_SEARCH_ENGINE_ID=your-google-cx-id
